# Copy to .env next to compose.yml and adjust.

# Image tag: "latest" follows main; pin a release such as "1.2.0" or a commit such as "sha-3f2c1ab" for reproducible deployments.
IMAGE_TAG=latest

# Port Nginx Proxy Manager forwards to ("Forward Port" of the proxy host).
HTTP_PORT=8080
# Interface the port is published on; 0.0.0.0 = all, so NPM on another host or container can reach it.
HTTP_BIND=0.0.0.0

# Host names the app answers to (semicolon-separated). "*" accepts any, which is convenient while setting up
# (e.g. access by IP); narrowing it protects against DNS rebinding once the name resolves.
ALLOWED_HOSTS=*
# ALLOWED_HOSTS=music.idsrv.info;localhost

# Stem separation through StemMyWav; leave both empty to hide the option in the interface.
# Either the address the gateway is published under, or http://stemmywav:8080 when this project joins its
# docker network (see the commented blocks in compose.yml).
STEMS_BASE_URL=
STEMS_API_KEY=

# Singing voice conversion through ChangeMyVoice; leave both empty to hide the option in the interface.
# The address the gateway is published under, e.g. https://voice.idsrv.info.
VOICE_BASE_URL=
VOICE_API_KEY=

# Where the instrument library (a SQLite file) is kept. Empty = the docker volume "yue-to-logic_data", which
# survives updates of the image. A host directory instead (e.g. /opt/yue-to-logic/data) must be writable by the
# app's user: chown 1654:1654 <dir>. Not a network share (NFS, CIFS) - SQLite needs proper file locks.
DATA_DIR=

TZ=Europe/Berlin
